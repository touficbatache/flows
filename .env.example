# PostgreSQL connection string used by Prisma.
# A Prisma Postgres / Accelerate URL (prisma+postgres://...) also works.
DATABASE_URL="postgresql://user:password@localhost:5432/flows"

# Optional: enables "Generate with AI"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# API server port (the Vite dev server proxies /api to http://localhost:3001)
PORT=3001

# Optional: API base URL for the front end when it is not served behind /api
# VITE_API_URL="https://api.example.com"
